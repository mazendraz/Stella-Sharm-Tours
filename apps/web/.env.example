API_INTERNAL_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEDIA_PUBLIC_URL=http://localhost:4000/media
# Required only when enabling the API revalidation integration:
WEB_REVALIDATE_SECRET=
# Runtime promotion overrides (preferred in production; legacy NEXT_PUBLIC_* work locally):
# SITE_URL=https://example.com
# PUBLIC_API_URL=https://api.example.com
# Optional private Sentry/GlitchTip DSN. No raw errors/user data are forwarded.
# SENTRY_DSN=
# Optional self-hosted analytics; absent values disable all tracker loading.
# UMAMI_SCRIPT_URL=https://stats.example.com/script.js
# UMAMI_WEBSITE_ID=
# robots.txt crawler switches (allow | block; unset = allow). Public pages
# only; private paths are always disallowed. Owner decisions:
# docs/seo/EXTERNAL-ACTIONS-REQUIRED.md (D1).
# AI search + user-triggered fetchers: OAI-SearchBot, ChatGPT-User,
# PerplexityBot, Perplexity-User, Claude-SearchBot, Claude-User.
# AI_SEARCH_CRAWLERS=allow
# Model training: GPTBot, ClaudeBot, Applebot-Extended, CCBot, meta-externalagent.
# AI_TRAINING_CRAWLERS=allow
# Google-Extended: Gemini training AND grounding (never Google Search).
# GOOGLE_EXTENDED=allow
