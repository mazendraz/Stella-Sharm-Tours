# Loaded by the worker only, after .env. Use a dedicated PostgreSQL worker role.
# Optional Push: all three together; private key is never exposed to the API/browser.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:owner@example.test
DATABASE_URL=postgresql://stella_worker:REPLACE_WORKER_PASSWORD@127.0.0.1:5432/stella_dev
TRANSLATE_PROVIDER=deepl
DEEPL_API_KEY=
GOOGLE_TRANSLATE_KEY=
LIBRETRANSLATE_URL=
# In free-only mode Google calls stay paused until the operator confirms a
# dedicated account/project with its free quota reserved for this worker.
GOOGLE_FREE_TIER_CONFIRMED=false
# SMTP_USER=
# SMTP_PASSWORD=
