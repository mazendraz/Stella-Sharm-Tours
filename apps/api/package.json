{
  "name": "@stella/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "worker": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.worker src/worker-main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.23",
    "@hono/node-server": "2.1.7",
    "@hono/zod-openapi": "1.6.3",
    "@node-rs/argon2": "2.2.2",
    "@stella/db": "workspace:*",
    "@stella/shared": "workspace:*",
    "busboy": "1.6.0",
    "drizzle-orm": "0.45.4",
    "file-type": "22.3.0",
    "hono": "4.13.18",
    "nodemailer": "10.5.0",
    "otplib": "13.6.0",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "web-push": "^3.6.7",
    "zod": "4.6.7"
  }
}
