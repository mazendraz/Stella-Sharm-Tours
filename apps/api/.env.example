NODE_ENV=development
# Optional Push: API public key only; matching public/private key and subject
# belong in the worker environment. Leave unset until real-device acceptance.
# VAPID_PUBLIC_KEY=
HOST=127.0.0.1
PORT=4000
DATABASE_URL=postgresql://stella_api:REPLACE_APP_PASSWORD@127.0.0.1:5432/stella_dev
SESSION_SECRET=
TOTP_ENC_KEY=
IP_HASH_SALT=
MEDIA_ROOT=../../.local/media
ORIGINALS_ROOT=../../.local/originals
MEDIA_PUBLIC_URL=http://127.0.0.1:4000/media
WEB_REVALIDATE_URL=http://127.0.0.1:3000/api/revalidate
WEB_REVALIDATE_SECRET=
WEB_ORIGIN=http://127.0.0.1:3000
ADMIN_ORIGIN=http://localhost:3001
TRUSTED_PROXY_IPS=
PUBLIC_READS_PER_MINUTE=600
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=stella@example.com
STAFF_NOTIFY_EMAIL=staff@example.com
SEED_OWNER_EMAIL=owner@example.com
BREACHED_PASSWORDS_FILE=../../.local/security/common-passwords-100k.txt
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
OWNER_REPORT_LOCALE=en
# Optional operator-configured private Sentry/GlitchTip DSN; allowlisted codes only.
# SENTRY_DSN=

# Local only: true = admin login with email + password, no 2FA. Refused unless NODE_ENV=development.
DEV_SIMPLE_ADMIN_LOGIN=false
