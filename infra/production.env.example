# Compose interpolation only, NOT all application secrets. See server-setup.md.
COMPOSE_PROJECT_NAME=stella-production
IMAGE_PREFIX=ghcr.io/REPLACE_ORG
RELEASE=REPLACE_40_CHARACTER_COMMIT_SHA
ENV_DIR=/srv/stella/production/env
DATA_DIR=/srv/stella/production
POSTGRES_DB=stella_prod
WEB_HOST=example.com
ADMIN_HOST=admin.example.com
API_HOST=api.example.com
MEDIA_HOST=media.example.com
ACME_EMAIL=owner@example.com
EDGE_SUBNET=172.30.20.0/24
EDGE_DYNAMIC_RANGE=172.30.20.128/25
CADDY_IP=172.30.20.2
# Set reviewed image@sha256 pins before a remote launch.
POSTGRES_IMAGE=postgres:16@sha256:e17e86066e5ef83e0952a9347f5c792b7ece00972e2aa787a6986f471b3dd3d5
CADDY_IMAGE=caddy:2-alpine@sha256:78bd35025c7ba85961dd149ae670315129954e77abe2383ac47c89106b35ade9
